# Groq API key - required for the /api/chat streaming endpoint
GROQ_API_KEY=

# Google Tag Manager container ID - optional, analytics is skipped when unset
NEXT_PUBLIC_GTM_ID=

# Resend API key - required for the /api/contact form endpoint
RESEND_API_KEY=

# Inbox that contact-form tickets are delivered to
CONTACT_TO_EMAIL=
